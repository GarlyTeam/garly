<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Garly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Why the app asks for each thing. iOS shows these words verbatim, and
	     App Review reads them: a vague reason here is a rejection. -->
	<key>NSMotionUsageDescription</key>
	<string>Garly reads movement to notice a fall, a struggle or a long stillness while Protection is on, so it can check on you before anyone else knows something is wrong.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Garly includes your location in an SOS, so the person you trust knows where to come.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Protection has to keep watching once your phone is in a pocket or a bag, with the screen off. Allowing Always is what lets Garly keep reading movement and send an SOS with your location when you cannot reach the phone yourself.</string>

	<!-- Without this, setting allowsBackgroundLocationUpdates raises an
	     exception. With it, Protection survives the screen locking, which on
	     iOS is the only sanctioned way to keep the sensors sampling. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- The manifest says portrait, and a safety screen that rotates while
	     someone is running is not a feature. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- HTTPS only, no encryption of our own: exempt, but it has to be said,
	     or every upload waits for an export-compliance answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
